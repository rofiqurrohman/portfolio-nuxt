# MongoDB connection string for the app (read-only user `portfolio-app`)
NUXT_MONGODB_URI=
# Database name inside the cluster
NUXT_MONGODB_DB_NAME=portfolio
# Fine-grained GitHub token (no extra permissions) for the contribution calendar
NUXT_GITHUB_TOKEN=
# Public site URL used for canonical links, sitemap and Open Graph (e.g. https://rofiqurrohman.vercel.app)
NUXT_PUBLIC_SITE_URL=
# MongoDB connection string with write access (user `portfolio-seed`), used only by `npm run db:seed`
SEED_MONGODB_URI=
